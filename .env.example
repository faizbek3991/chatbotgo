# Copy this file to .env and fill in your own values.
# .env is loaded automatically at startup (see internal/config/config.go).

# Free at https://aistudio.google.com/apikey — 1,500 requests/day on gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas connection string (Database > Connect > Drivers > Go)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gemini_agent?retryWrites=true&w=majority
MONGODB_DB=gemini_agent

PORT=8080

# Whoever signs up with this email automatically gets the admin role.
# Leave blank and no one will be admin until you set this and re-sign-up
# (or update the user's role field directly in Atlas).
ADMIN_EMAIL=
